# --- OpenAI ---
# Used server-side to generate the offer analysis (GPT-4o, ~$0.10 / analysis).
OPENAI_API_KEY=sk-...

# --- Stripe ---
# Use sk_test_... / pk_test_... while testing, then switch to live keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- App ---
# Public base URL of the deployment. Used to build Stripe success/cancel URLs
# and Open Graph metadata. In local dev use http://localhost:3000.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
