# --- OpenRouter ---
# Get your free key at https://openrouter.ai/keys (no billing required for free models)
OPENROUTER_API_KEY=sk-or-v1-...

# Model to use (default is the free Llama 3.3 70B — uncomment to override)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free   # free
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free   # free, very capable, slower
# OPENROUTER_MODEL=openai/gpt-4o-mini                       # paid, ~$0.01 / analysis
# OPENROUTER_MODEL=anthropic/claude-3-haiku                 # paid, ~$0.01 / analysis

# --- Stripe ---
# Use sk_test_... / pk_test_... while testing, then switch to live keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- App ---
# Public base URL of the deployment. Used to build Stripe success/cancel URLs
# and Open Graph metadata. In local dev use http://localhost:3000.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
