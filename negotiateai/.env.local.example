# --- OpenRouter (AI) ---
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Optional model override (default: openai/gpt-4o-mini)
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Payment (TryBit / CryptoCloud) ---
# From your TryBit dashboard: Security → API key (shown once), and your project's
# Shop ID + Secret (project settings). The Secret verifies postback JWTs.
TRYBIT_API_KEY=your-api-key
TRYBIT_SHOP_ID=your-shop-id
TRYBIT_SECRET=your-project-secret
# API host. Default targets the CryptoCloud host; override if TryBit gives you a
# different base URL in their docs (keep the /v2 suffix).
# TRYBIT_API_BASE=https://api.cryptocloud.plus/v2
# Price charged per analysis in USD. Optional, defaults to 9.00.
# PRICE_USD=9.00

# --- Code delivery email (Resend) ---
# Get a key at https://resend.com. The payment webhook emails the buyer's code.
RESEND_API_KEY=re_...
# Sender must be a verified domain in Resend (onboarding@resend.dev for testing).
EMAIL_FROM=NegotiateAI <onboarding@resend.dev>

# --- Access codes ---
# Secret used to mint & verify signed single-use codes. Make it long & random.
# The payment webhook mints codes with this. You can also pre-mint a batch:
#   ACCESS_CODE_SECRET=... node scripts/gen-codes.mjs 50
ACCESS_CODE_SECRET=change-me-to-a-long-random-string

# Optional: one shared code accepted in addition to signed codes. NOT single-use.
# ACCESS_CODE_STATIC=

# Upstash Redis (REST) for durable single-use + order tracking across deploys.
# REQUIRED for auto-unlock: the webhook and the form's poll run on different
# serverless invocations, so the order→code record must live in shared storage.
# Without it, codes are tracked in memory and reset on restart (the emailed code
# still works as a manual fallback).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Vercel's Upstash/KV integration injects these names instead — the app reads
# either pair, so you don't need to rename anything:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- App ---
# Public base URL — used for the TryBit return/callback URLs, email links, AND
# all SEO (canonical URLs, sitemap, robots, JSON-LD). Pick ONE canonical host
# (with or without www) and use it everywhere; mixing splits ranking signals.
# In production set this to your real domain (must be reachable by TryBit).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- SEO ---
# Google Search Console "HTML tag" verification token (just the content value).
# Add it after you create the property; it renders the verification meta tag.
# GOOGLE_SITE_VERIFICATION=
