# --- OpenRouter (AI) ---
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Optional model override (default: openai/gpt-4o-mini)
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Payment / access (Boosty) ---
# Boosty has no API to verify a one-off payment, so access is gated by codes you
# sell on Boosty. The button on the unlock step links here:
NEXT_PUBLIC_BOOSTY_URL=https://boosty.to/your-page

# Secret used to mint & verify signed single-use codes. Make it long & random.
# Generate codes:  ACCESS_CODE_SECRET=... node scripts/gen-codes.mjs 50
ACCESS_CODE_SECRET=change-me-to-a-long-random-string

# Optional: one shared code (e.g. placed inside a subscribers-only Boosty post).
# Accepted in addition to signed codes. NOT single-use.
# ACCESS_CODE_STATIC=

# Optional: Upstash Redis (REST) for durable single-use enforcement across
# deploys. Without it, single-use is tracked in memory and resets on restart.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
